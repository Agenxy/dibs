{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_poll",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}"
            },
            "timeout": 10,
            "statusMessage": "Checking Dibs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "transcript_path": "${transcript_path}"
            },
            "timeout": 10,
            "statusMessage": "Reporting to Dibs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_poll",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}"
            },
            "timeout": 5,
            "statusMessage": "Checking Dibs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_poll",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 10,
            "statusMessage": "Checking Dibs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}"
            },
            "timeout": 10,
            "statusMessage": "Reporting to Dibs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_poll",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}",
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 10,
            "statusMessage": "Checking Dibs"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "hook_session",
            "input": {
              "session_id": "${session_id}",
              "event": "${hook_event_name}",
              "cwd": "${cwd}"
            },
            "timeout": 10,
            "statusMessage": "Reporting to Dibs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(dibs hook-spawn 2>/dev/null) && case \"$out\" in \"{\"*) printf %s \"$out\";; esac; exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:dibs:dibs",
            "tool": "guard_path",
            "input": {
              "session_id": "${session_id}",
              "path": "${tool_input.file_path}",
              "cwd": "${cwd}"
            },
            "timeout": 5,
            "statusMessage": "Checking Dibs claims"
          }
        ]
      }
    ]
  }
}
