{
  "description": "Dibs: deliver mail into the session instead of making the agent poll for it.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "dibs",
            "tool": "hook_poll",
            "input": { "session_id": "${session_id}", "event": "${hook_event_name}", "cwd": "${cwd}" },
            "timeout": 10,
            "statusMessage": "Checking Dibs"
          },
          {
            "type": "mcp_tool",
            "server": "dibs",
            "tool": "hook_session",
            "input": { "session_id": "${session_id}", "event": "${hook_event_name}", "cwd": "${cwd}" },
            "timeout": 10,
            "statusMessage": "Reporting to Dibs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "dibs",
            "tool": "hook_poll",
            "input": { "session_id": "${session_id}", "event": "${hook_event_name}", "cwd": "${cwd}" },
            "timeout": 10,
            "statusMessage": "Checking Dibs"
          }
        ]
      }
    ]
  }
}
